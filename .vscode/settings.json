{
  // .venv (14.596 archivos) y data (124 MB) no se editan a mano: sacarlos del
  // watcher y del indice evita que la ventana tarde ~20s en responder al abrir.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/data/**": true,
    "**/.git/objects/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/data": true,
    "**/__pycache__": true
  },
  // Barras normales: con barras invertidas sin escapar esto era JSON invalido
  // y VS Code caia al interprete global en vez de al del proyecto.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.exclude": ["**/.venv/**", "**/data/**"]

  // --- Copilot: configuracion RETIRADA (2026-09-08) --------------------
  // Ya no hay trabajo en equipo con Copilot: Claude Code es el unico agente
  // de este repo. Se borraron .github/copilot-instructions.md,
  // .github/instructions/, .github/prompts/ y AGENTS.md, asi que los ajustes
  // que apuntaban ahi quedaban colgando de archivos inexistentes.
  //
  // Las reglas duras que vivian en esas instrucciones NO se perdieron: estan
  // en CLAUDE.md y, con la medicion que las justifica, en
  // design/reglas_negocio.md.
}
