.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Archivos reales de INVIMA / Gemma Net: pesan decenas de MB y traen datos
# de produccion -- nunca al repositorio.
data/

# Credenciales locales (DSN de la base de Gemma Net, tokens). NUNCA al
# repositorio: la base es produccion de Pijao Salud. El deny de
# .claude/settings.json impide que un agente las lea; esto impide que git
# las commitee, que es un riesgo distinto.
.env
.env.*

# Estado local de Claude Code. Las definiciones de .claude/agents/ y
# .claude/AGENTES.md SI se versionan: son configuracion del proyecto.
.claude/scheduled_tasks.lock
.claude/hooks/.estado_pytest.json

# Salidas de corridas locales (reportes, cargues, pruebas a mano).
scratch_*.xlsx
reporte_*.xlsx
auditoria_*.xlsx
cargue_*.xlsx

# Respaldo local de la UI y consulta con metricas operativas: no son fuente
# publicable ni deben entrar por accidente en el primer commit.
ui_revision/app_streamlit.py.bak
consultas/verificar_auditoria.sql

# Snapshots del worker (worker/almacen_snapshots.py) y su registro de salud
# (worker/estado.py) -- artefactos DERIVADOS y regenerables, no fuente de
# verdad. Distinto de data/: no son el archivo original de INVIMA/Gemma Net,
# son el resultado ya procesado que el worker recalcula cada ~50 min.
data_runtime/
# Nombre actual de esa misma carpeta. `data_runtime/` quedo del nombre
# anterior y por si sola dejaba `snapshots/` sin ignorar: son ~94 MB de
# Parquet derivados de la base de PRODUCCION de Pijao Salud, que segun
# CLAUDE.md nunca deben subirse al repositorio.
snapshots/

# Log del uvicorn local.
.uvicorn_out.log

# Frontend (Fase 3): dependencias y build, se regeneran con npm install/
# npm run build -- no son fuente, no se versionan.
frontend/node_modules/
frontend/dist/
